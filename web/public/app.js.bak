const API = window.location.pathname.replace(/\/?$/, "");
let lang = "th";
let viewMode = "overlay"; // overlay | list
let current = null;
let pollTimer = null;
let pendingFile = null;

async function fetchJSON(url, opts) {
  const r = await fetch(API + url, opts);
  if (!r.ok) throw new Error(await r.text());
  return r.json();
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, m => ({
    "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"
  })[m]);
}

function pickText(line) {
  if (lang === "th") return line.th || line.src || "";
  if (lang === "en") return line.en || line.src || "";
  return line.src || "";
}










function clampPct(n, lo, hi) {
  n = Number(n) || 0;
  return Math.max(lo, Math.min(hi, n));
}

function normalizeBox(b) {
  let left = clampPct(b.left, 0, 95);
  let top = clampPct(b.top, 0, 95);
  let width = clampPct(b.width, 4, 46);
  let height = clampPct(b.height, 3, 28);
  if (left + width > 100) width = 100 - left;
  if (top + height > 100) height = 100 - top;
  return { left, top, width, height };
}

function rectsOverlap(a, b, gap = 6) {
  return !(a.right + gap <= b.left || b.right + gap <= a.left ||
           a.bottom + gap <= b.top || b.bottom + gap <= a.top);
}

function fitBubble(el) {
  const stage = el.parentElement;
  if (!stage) return;
  const stageW = stage.clientWidth, stageH = stage.clientHeight;
  if (!stageW || !stageH) return;

  const aL = parseFloat(el.dataset.left || "0");
  const aT = parseFloat(el.dataset.top || "0");
  const aW = parseFloat(el.dataset.w || "10");
  const aH = parseFloat(el.dataset.h || "8");
  const cx = ((aL + aW / 2) / 100) * stageW;
  const cy = ((aT + aH / 2) / 100) * stageH;

  el.style.display = "block";
  el.style.position = "absolute";
  el.style.fontSize = "15px";
  el.style.lineHeight = "1.65";
  el.style.padding = "10px 10px 12px";
  el.style.overflow = "visible";
  el.style.width = "max-content";
  el.style.height = "auto";
  el.style.maxWidth = Math.min(stageW * 0.38, 320) + "px";
  el.style.maxHeight = "none";
  el.style.left = "0px";
  el.style.top = "0px";
  el.style.visibility = "hidden";
  void el.offsetHeight;

  let w = Math.ceil(el.scrollWidth);
  let h = Math.ceil(el.scrollHeight);
  w = Math.max(40, Math.min(w, stageW * 0.38));
  h = Math.max(30, Math.min(h, stageH * 0.32));

  let left = cx - w / 2;
  let top = cy - h / 2;
  left = Math.max(0, Math.min(left, stageW - w));
  top = Math.max(0, Math.min(top, stageH - h));

  el.style.left = left + "px";
  el.style.top = top + "px";
  el.style.width = w + "px";
  el.style.height = h + "px";
  el.style.visibility = "visible";
}

function resolveOverlaps(root) {
  const stage = root.querySelector(".page-stage");
  if (!stage) return;
  const stageW = stage.clientWidth, stageH = stage.clientHeight;
  const bubbles = [...stage.querySelectorAll(".bubble")];
  for (let pass = 0; pass < 10; pass++) {
    let moved = false;
    for (let i = 0; i < bubbles.length; i++) {
      for (let j = i + 1; j < bubbles.length; j++) {
        const sr = stage.getBoundingClientRect();
        const ar = bubbles[i].getBoundingClientRect();
        const br = bubbles[j].getBoundingClientRect();
        const A = {left: ar.left-sr.left, top: ar.top-sr.top, right: ar.right-sr.left, bottom: ar.bottom-sr.top};
        const B = {left: br.left-sr.left, top: br.top-sr.top, right: br.right-sr.left, bottom: br.bottom-sr.top};
        if (!rectsOverlap(A, B, 6)) continue;
        const overlapY = Math.min(A.bottom, B.bottom) - Math.max(A.top, B.top);
        const lower = A.top <= B.top ? bubbles[j] : bubbles[i];
        const curTop = parseFloat(lower.style.top) || 0;
        const h = lower.offsetHeight;
        let next = curTop + overlapY + 8;
        if (next + h > stageH) next = Math.max(0, curTop - (overlapY + 8));
        lower.style.top = next + "px";
        moved = true;
      }
    }
    if (!moved) break;
  }
}

function fitAllBubbles(root) {
  (root || document).querySelectorAll(".bubble").forEach(fitBubble);
  resolveOverlaps(root || document);
}







function setPendingFile(file) {
  if (!file) return;
  const ok = file.type.startsWith("image/") || file.name.toLowerCase().endsWith(".zip");
  if (!ok) {
    document.getElementById("uploadMsg").textContent = "รองรับเฉพาะรูป หรือไฟล์ ZIP";
    return;
  }
  pendingFile = file;
  try {
    const dt = new DataTransfer();
    dt.items.add(file);
    document.getElementById("file").files = dt.files;
  } catch (_) {}
  const preview = document.getElementById("pastePreview");
  const hint = document.getElementById("pasteHint");
  if (file.type.startsWith("image/")) {
    preview.innerHTML = `<img src="${URL.createObjectURL(file)}" alt="preview" />`;
    preview.classList.remove("hidden");
    hint.textContent = `พร้อมอัปโหลด: ${file.name || "pasted-image"} (${Math.round(file.size/1024)} KB)`;
  } else {
    preview.classList.add("hidden");
    hint.textContent = `พร้อมอัปโหลด: ${file.name}`;
  }
}

function fileFromClipboard(e) {
  const items = e.clipboardData && e.clipboardData.items;
  if (!items) return null;
  for (const item of items) {
    if (item.type && item.type.startsWith("image/")) {
      const blob = item.getAsFile();
      if (!blob) continue;
      const ext = (item.type.split("/")[1] || "png").replace("jpeg", "jpg");
      return new File([blob], `paste-${Date.now()}.${ext}`, { type: item.type });
    }
  }
  return null;
}

async function loadChapters() {
  const list = await fetchJSON("/api/chapters");
  const el = document.getElementById("chapters");
  if (!list.length) {
    el.innerHTML = "<p class='msg'>ยังไม่มีบท</p>";
    return;
  }
  el.innerHTML = list.map(c => `
    <div class="chapter">
      <div>
        <strong>${escapeHtml(c.title)}</strong>
        <div class="badge">${c.status} · ${c.done_pages || 0}/${c.total_pages}</div>
      </div>
      <button type="button" data-id="${c.id}">อ่าน</button>
    </div>
  `).join("");
  el.querySelectorAll("button[data-id]").forEach(btn => {
    btn.onclick = () => openChapter(btn.dataset.id);
  });
}

async function doUpload() {
  const title = document.getElementById("title").value || "untitled";
  const file = pendingFile || document.getElementById("file").files[0];
  const msg = document.getElementById("uploadMsg");
  if (!file) { msg.textContent = "เลือกไฟล์ หรือวางรูป (Ctrl+V) ก่อน"; return; }
  msg.textContent = "กำลังอัปโหลด...";
  const fd = new FormData();
  fd.append("file", file, file.name || "paste.png");
  try {
    const q = new URLSearchParams({ title });
    const r = await fetch(API + "/api/chapters/upload?" + q, { method: "POST", body: fd });
    if (!r.ok) throw new Error(await r.text());
    const meta = await r.json();
    msg.textContent = "เข้าคิวแล้ว: " + meta.id;
    pendingFile = null;
    await loadChapters();
    openChapter(meta.id);
  } catch (e) {
    msg.textContent = "ผิดพลาด: " + e.message;
  }
}

document.getElementById("uploadBtn").onclick = doUpload;
document.getElementById("file").addEventListener("change", (e) => {
  const f = e.target.files && e.target.files[0];
  if (f) setPendingFile(f);
});

const pasteZone = document.getElementById("pasteZone");
if (pasteZone) {
  pasteZone.addEventListener("click", () => pasteZone.focus());
  pasteZone.addEventListener("paste", (e) => {
    const file = fileFromClipboard(e);
    if (file) { e.preventDefault(); setPendingFile(file); }
  });
  pasteZone.addEventListener("dragover", (e) => { e.preventDefault(); pasteZone.classList.add("dragover"); });
  pasteZone.addEventListener("dragleave", () => pasteZone.classList.remove("dragover"));
  pasteZone.addEventListener("drop", (e) => {
    e.preventDefault();
    pasteZone.classList.remove("dragover");
    const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) setPendingFile(f);
  });
}

document.addEventListener("paste", (e) => {
  const tag = (e.target && e.target.tagName) || "";
  if (tag === "INPUT" || tag === "TEXTAREA") return;
  const file = fileFromClipboard(e);
  if (file) { e.preventDefault(); setPendingFile(file); }
});

async function openChapter(id) {
  current = await fetchJSON("/api/chapters/" + id);
  document.getElementById("reader").classList.remove("hidden");
  document.getElementById("readerTitle").textContent = current.title;
  renderPages();
  if (pollTimer) clearInterval(pollTimer);
  pollTimer = setInterval(async () => {
    current = await fetchJSON("/api/chapters/" + id);
    document.getElementById("statusLine").textContent =
      `สถานะ: ${current.status} (${current.done_pages}/${current.total_pages})`;
    renderPages();
    if (current.status === "done") clearInterval(pollTimer);
  }, 4000);
}

async function renderPages() {
  const root = document.getElementById("pages");
  const blocks = [];
  for (const page of current.pages) {
    const stem = page.replace(/\.[^.]+$/, "");
    let tr = { lines: [], status: "pending" };
    try { tr = await fetchJSON(`/api/chapters/${current.id}/pages/${stem}/translation`); } catch {}
    const lines = tr.lines || [];
    const hasBoxes = lines.some(l => l.box);

    let overlays = "";
    if (viewMode === "overlay" && hasBoxes && lang !== "src") {
      overlays = lines.map((l, idx) => {
        if (!l.box) return "";
        const t = pickText(l);
        if (!t) return "";
        const b = normalizeBox(l.box);
        return `<div class="bubble" data-left="${b.left}" data-top="${b.top}" data-w="${b.width}" data-h="${b.height}" style="
          left:${b.left}%;top:${b.top}%;font-size:15px;
        "><span class="n">${idx+1}</span>${escapeHtml(t)}</div>`;
      }).join("");
    }

    // Priority 1: always show complete translations under the page
    const listItems = lines.map((l, idx) => {
      const t = pickText(l);
      return `<div class="item"><div class="num">${idx+1}</div><div>${escapeHtml(t || "(ว่าง)")}</div></div>`;
    }).join("") || "<p class='msg'>รอ OCR / แปล...</p>";
    const list = `<div class="lines-fallback"><strong>คำแปลครบทั้งหน้า</strong>${listItems}</div>`;

    blocks.push(`
      <div class="page-block">
        <div class="page-stage">
          <img src="${API}/api/chapters/${current.id}/pages/${encodeURIComponent(page)}" alt="${page}" loading="lazy" />
          ${overlays}
        </div>
        ${list}
      </div>
    `);
  }
  root.innerHTML = blocks.join("");
  const imgs = root.querySelectorAll(".page-stage img");
  let pending = imgs.length;
  const done = () => { fitAllBubbles(root); };
  if (!pending) done();
  imgs.forEach(img => {
    if (img.complete) {
      pending -= 1;
      if (!pending) done();
    } else {
      img.addEventListener("load", () => {
        pending -= 1;
        if (!pending) done();
      }, { once: true });
      img.addEventListener("error", () => {
        pending -= 1;
        if (!pending) done();
      }, { once: true });
    }
  });
  // also refit shortly after layout
  setTimeout(() => fitAllBubbles(root), 50);
  setTimeout(() => fitAllBubbles(root), 300);
}


document.getElementById("backBtn").onclick = () => {
  document.getElementById("reader").classList.add("hidden");
  if (pollTimer) clearInterval(pollTimer);
  loadChapters();
};

document.querySelectorAll(".lang-btn").forEach(btn => {
  btn.onclick = () => {
    lang = btn.dataset.lang;
    document.querySelectorAll(".lang-btn").forEach(b => b.classList.toggle("active", b === btn));
    if (current) renderPages();
  };
});

// view mode buttons if present
document.querySelectorAll(".view-btn").forEach(btn => {
  btn.onclick = () => {
    viewMode = btn.dataset.view;
    document.querySelectorAll(".view-btn").forEach(b => b.classList.toggle("active", b === btn));
    if (current) renderPages();
  };
});

loadChapters().catch(e => {
  document.getElementById("chapters").textContent = "API ยังไม่พร้อม: " + e.message;
});
